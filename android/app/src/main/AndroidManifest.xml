<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ANDROID-2: Deep Links -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="athenea" />
            </intent-filter>

            <!-- ANDROID-1: App Shortcuts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <receiver
            android:name=".AtheneaWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/athenea_widget_info" />
        </receiver>

        <receiver
            android:name=".AtheneaWidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.athenea.app.WIDGET_OPEN_OMNIBAR" />
                <action android:name="com.athenea.app.WIDGET_OPEN_VOICE" />
                <action android:name="com.athenea.app.WIDGET_CHECK_TASK" />
            </intent-filter>
        </receiver>

        <!-- ANDROID-3: Nav Widget (4-button deep link navigation) -->
        <receiver
            android:name=".AtheneaNavWidget"
            android:exported="true"
            android:label="ATHENEA Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nav_info" />
        </receiver>

        <!-- 9 smart widgets -->
        <receiver android:name=".widgets.DailyFocusWidget" android:exported="true" android:label="ATHENEA Daily Focus">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_daily_focus" />
        </receiver>

        <receiver android:name=".widgets.TaskQuickAddWidget" android:exported="true" android:label="ATHENEA Quick Task">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_task_quick_add" />
        </receiver>

        <receiver android:name=".widgets.FinanceSnapshotWidget" android:exported="true" android:label="ATHENEA Finance">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_finance_snapshot" />
        </receiver>

        <receiver android:name=".widgets.PendingTasksWidget" android:exported="true" android:label="ATHENEA Tasks">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_pending_tasks" />
        </receiver>

        <receiver android:name=".widgets.TodayAgendaWidget" android:exported="true" android:label="ATHENEA Agenda">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_today_agenda" />
        </receiver>

        <receiver android:name=".widgets.IntelligenceFeedWidget" android:exported="true" android:label="ATHENEA Intelligence">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_intelligence_feed" />
        </receiver>

        <receiver android:name=".widgets.HabitTrackerWidget" android:exported="true" android:label="ATHENEA Habits">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_habit_tracker" />
        </receiver>

        <receiver android:name=".widgets.FinanceQuickLogWidget" android:exported="true" android:label="ATHENEA Quick Expense">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_finance_quick_log" />
        </receiver>

        <receiver android:name=".widgets.SystemHealthWidget" android:exported="true" android:label="ATHENEA Health">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_system_health" />
        </receiver>

        <!-- Widget action broadcast receiver (routine toggles, etc.) -->
        <receiver android:name=".widgets.WidgetActionReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.athenea.app.WIDGET_TOGGLE_ROUTINE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AtheneaNotificationListenerService"
            android:label="ATHENEA Notification Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
</manifest>
